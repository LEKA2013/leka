# Copie para .env (não versionado) ou exporte no shell da máquina CENSIPAM.
# No Windows PowerShell: $env:CENSIPAM_ERA5_ROOT = "\\files-be\NCEP\era5"

# ERA5 / dados climáticos institucionais (padrão Windows UNC)
CENSIPAM_ERA5_ROOT=\\files-be\NCEP\era5

# MERGE (precipitação) — dados diários (NetCDF)
CENSIPAM_MERGE_ROOT=S:\Leticia\dados_INPE\MERGE_NC

# Máscara Amazônia Legal (shapefile ou GeoJSON fornecido pela equipe)
# CENSIPAM_AMAZONIA_LEGAL_MASK=
